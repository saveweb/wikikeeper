# WikiKeeper Environment Configuration

# Application
APP_NAME=WikiKeeper
APP_VERSION=0.1.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
